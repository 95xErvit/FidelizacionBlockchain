# Copia este archivo como .env.local y completa los valores.
# En Vercel van en Settings → Environment Variables (los mismos nombres).

# ── Red Stellar (públicas: las usa el navegador) ──
VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Sale de contracts/deploy-testnet.out.md después de desplegar
VITE_CONTRACT_ID=

# ── Base de datos (SOLO servidor: sin prefijo VITE_, nunca llegan al navegador) ──
SUPABASE_URL=https://ipgifijmmraezbcnahmg.supabase.co
# Supabase → Project Settings → API Keys → "secret" (sb_secret_…) o "service_role"
SUPABASE_SECRET_KEY=
